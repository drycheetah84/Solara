<Project Sdk="Microsoft.NET.Sdk">
  <!-- Differential-test oracle: runs scenario requests through the ORIGINAL Halcyon servers
       in-process (HttpListener.Start neutralised with Harmony, so no privileged ports are
       bound) and prints normalisable results. See tools/difftest/README.md. -->
  <PropertyGroup><OutputType>Exe</OutputType><TargetFramework>net6.0</TargetFramework><ImplicitUsings>enable</ImplicitUsings><Nullable>disable</Nullable></PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Lib.Harmony" Version="2.3.3" />
    <PackageReference Include="LiteDB" Version="5.0.21" />
    <Reference Include="AUnrealFeatures.Ares"><HintPath>..\..\reference\halcyon\backend\src\AUnrealFeatures.Ares\bin\Debug\net6.0\AUnrealFeatures.Ares.dll</HintPath></Reference>
    <Reference Include="AUnrealFeatures.Hosting"><HintPath>..\..\reference\halcyon\backend\src\AUnrealFeatures.Ares\bin\Debug\net6.0\AUnrealFeatures.Hosting.dll</HintPath></Reference>
    <Reference Include="AUnrealFeatures.AAMothership"><HintPath>..\..\reference\halcyon\backend\src\AUnrealFeatures.Ares\bin\Debug\net6.0\AUnrealFeatures.AAMothership.dll</HintPath></Reference>
    <Reference Include="AUnrealFeatures.EOSSDK"><HintPath>..\..\reference\halcyon\backend\src\AUnrealFeatures.Ares\bin\Debug\net6.0\AUnrealFeatures.EOSSDK.dll</HintPath></Reference>
    <Reference Include="AUnrealFeatures.HalcyonSocket"><HintPath>..\..\reference\halcyon\backend\src\AUnrealFeatures.Ares\bin\Debug\net6.0\AUnrealFeatures.HalcyonSocket.dll</HintPath></Reference>
    <Reference Include="AUnrealFeatures.DependencyInjection"><HintPath>..\..\reference\halcyon\backend\src\AUnrealFeatures.Ares\bin\Debug\net6.0\AUnrealFeatures.DependencyInjection.dll</HintPath></Reference>
    <Reference Include="Serilog"><HintPath>..\..\reference\halcyon\backend\src\AUnrealFeatures.Ares\bin\Debug\net6.0\Serilog.dll</HintPath></Reference>
  </ItemGroup>
</Project>
