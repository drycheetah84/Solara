<Project Sdk="Microsoft.NET.Sdk">
  <!-- Data-migration bridge: reads an original Halcyon LiteDB 5 database with LiteDB itself
       (same version the backend used) and writes one JSON-lines file per collection in LiteDB
       extended JSON, which `solara import-litedb` loads. Read-only on the source file. -->
  <PropertyGroup><OutputType>Exe</OutputType><TargetFramework>net6.0</TargetFramework><ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable><RollForward>Major</RollForward></PropertyGroup>
  <ItemGroup><PackageReference Include="LiteDB" Version="5.0.21" /></ItemGroup>
</Project>
